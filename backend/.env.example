# Local backend configuration; copy to .env and fill as needed.
# Do not commit real API keys or connection strings.
GITHUB_TOKEN=
LLM_API_KEY=

# Neon pooled connection for normal API runtime traffic.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require

# Neon direct (non-pooler) connection used only by Alembic migrations.
DIRECT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example.us-west-2.aws.neon.tech/neondb?sslmode=require

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=300
DB_ECHO=false

# Fixed schema dimension: set before applying revision 0004 and keep consistent.
# Changing an existing database dimension requires a new migration.
EMBEDDING_DIMENSION=768
EMBEDDING_MODEL=nomic-ai/CodeRankEmbed
EMBEDDING_REVISION=3c4b60807d71f79b43f3c4363786d9493691f8b1
EMBEDDING_DEVICE=cpu
# Supported CPU benchmark sizes: 4, 8, or 16.
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_TOKENS=1024
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_POLL_SECONDS=5

# Optional local-only ONNX reranker; provision artifacts per docs/search-reranking.md.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L4-v2
RERANKER_PATH=models/reranker
RERANKER_TOP_N=20
RERANKER_MAX_LENGTH=256
RERANKER_BATCH_SIZE=1
RERANKER_MEMORY_LIMIT_MB=512
RERANKER_HEADROOM_MB=220
SEARCH_MAX_CANDIDATES=100
SEARCH_KEYWORD_ENABLED=true
SEARCH_SYMBOL_ENABLED=true
SEARCH_RRF_K=60
SEARCH_STRUCTURE_ENABLED=true
SEARCH_STRUCTURE_RRF_BONUS=0.0002
SEARCH_STRUCTURE_LOGIT_BONUS=0.1

# Durable ingestion worker limits (existing file filter caps each file at 200 KiB).
INGESTION_BATCH_SIZE=10
INGESTION_BATCH_BYTES=524288
INGESTION_BATCH_SECONDS=20
INGESTION_MAX_FILES=10000
INGESTION_MAX_BYTES=52428800
INGESTION_MAX_ATTEMPTS=3
INGESTION_POLL_SECONDS=2

# Phase 4A: separately provisioned, local-only Ollama (never downloaded by the API).
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_TOKENS=512
OLLAMA_CONTEXT_TOKENS=4096
INTERVIEW_RETRIEVAL_COUNT=4
INTERVIEW_CONTEXT_CHARS=4000
INTERVIEW_CHUNK_CHARS=1000
INTERVIEW_HISTORY_CHARS=6000
INTERVIEW_MAX_TURNS=12
